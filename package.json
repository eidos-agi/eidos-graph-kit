{
  "name": "@eidos-agi/graph-kit",
  "version": "0.1.0",
  "description": "Tiny deterministic graph layout and SVG rendering toolkit.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Eidos AGI",
  "homepage": "https://github.com/eidos-agi/eidos-graph-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidos-agi/eidos-graph-kit.git"
  },
  "bugs": {
    "url": "https://github.com/eidos-agi/eidos-graph-kit/issues"
  },
  "keywords": [
    "graph",
    "layout",
    "svg",
    "diagram",
    "flowchart",
    "typescript"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "guard": "node scripts/guard-package.mjs",
    "review": "npm run build && node scripts/build-review-page.mjs",
    "verify": "npm run check && npm test && npm run guard"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
